{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/__/auth/(.*)",
      "destination": "https://zenvio-fxo.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/api/ai/status",
      "destination": "/api/ai"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
